#大模型配置key和url,自己在系统环境变量里面配置即可(这里只是临时配置使用)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.3-flash
EMBEDDINGS_MODEL_NAME=text-embedding-v4

# Milvus链接
MILVUS_HOST=localhost
MILVUS_PORT=19530
COLLECTION_NAME=snail_store
# 向量检索匹配几个
TOP_K=3
# 文本分片的大小
CHUNK_SIZE=500
# 两个连续分片之间允许的重叠的字符数据
CHUNK_OVERLAP=50
# 自然分段的分割符
SEPARATORS=["\n\n","\n","。",".","?","？","!","","  "]

# 应用
UPLOAD_DIR=./uploads
